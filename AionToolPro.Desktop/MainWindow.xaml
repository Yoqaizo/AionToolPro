<Window x:Class="AionToolPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AionToolPro"
        Icon="AionToolp.ico"
        Width="1280" Height="800" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        SizeChanged="MainWindow_SizeChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="PulseDot1" Storyboard.TargetProperty="Opacity" From="0.35" To="1.0" Duration="0:0:0.85"/>
                    <DoubleAnimation Storyboard.TargetName="PulseDot2" Storyboard.TargetProperty="Opacity" From="0.35" To="1.0" Duration="0:0:0.85"/>
                    <DoubleAnimation Storyboard.TargetName="PulseDot3" Storyboard.TargetProperty="Opacity" From="0.35" To="1.0" Duration="0:0:0.85"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootWindowBorder" Background="{DynamicResource WindowCanvasBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== CUSTOM FRAMELESS TITLE BAR ==================== -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource SidebarSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left: Only Green/Red Internet Status Light + AionToolPro Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="HeaderStatusLed" Width="10" Height="10" Fill="#F43F5E" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Internet Status">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="HeaderStatusGlow" BlurRadius="10" ShadowDepth="0" Color="#F43F5E" Opacity="0.85"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="AionToolPro" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center Live Status Summary + Speedometer + Auto Packet Loss (In / Out) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="BdHeaderQuickSummary" Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="11,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtHeaderQuickSummary" Text="1.1.1.1: --  ·  Arvan: --  ·  Router: --" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" FlowDirection="LeftToRight" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <Border x:Name="BdHeaderSpeed" Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                <TextBlock x:Name="TxtSpeedDl" Text="⬇ 0 KB/s" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="#10B981" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtSpeedUl" Text="⬆ 0 KB/s" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="#F59E0B"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BdHeaderPacketLoss" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" ToolTip="Real-Time Sliding-Window Packet Loss &amp; NIC Hardware Drops">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                <TextBlock x:Name="TxtPacketLossIn" Text="Loss: 0.0%" FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource MonoFontFamily}" Foreground="#10B981" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtPacketLossOut" Text="NIC: 0d" FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource MonoFontFamily}" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Window Chrome Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize" Content="—" Click="BtnMinimize_Click" Style="{StaticResource WindowChromeBtnStyle}" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="BtnMaximize" Content="▢" Click="BtnMaximize_Click" Style="{StaticResource WindowChromeBtnStyle}" ToolTip="Maximize" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="BtnClose" Content="✕" Click="BtnClose_Click" Style="{StaticResource WindowChromeCloseBtnStyle}" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN WORKSPACE ==================== -->
            <Grid x:Name="MainWorkspaceGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="245"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== SIDEBAR ==================== -->
                <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="0,0,1,0" Padding="14,16,14,12">
                    <DockPanel LastChildFill="True">

                        <!-- Network Adaptor Selector with Green / Orange / Red Status Dots -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblNetworkAdaptor" Grid.Column="0" Text="Network Adaptor" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Content="↻" Click="BtnRefreshAdapters_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="7,2" Margin="0" ToolTip="Scan Adaptors"/>
                                </Grid>
                                <ComboBox x:Name="InterfaceCombo" SelectionChanged="InterfaceCombo_SelectionChanged" Height="34" FlowDirection="LeftToRight">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Bottom-Left: Pinned Version Footer (Always visible even at 560px window height) -->
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Created By Yoqaizo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="TxtAppVersion" Text="0.9.2" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Categorized Modern Navigation (Fills remaining height and scrolls cleanly) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="LblNavCatOverview" Text="OVERVIEW" Style="{StaticResource NavCategoryHeaderStyle}" Margin="8,0,8,3"/>
                                <RadioButton x:Name="NavDashboard" Content="⚡  Dashboard" IsChecked="True" Checked="Nav_Checked" Tag="Dashboard" Style="{StaticResource NavRadioStyle}"/>

                                <TextBlock x:Name="LblNavCatNetwork" Text="NETWORK &amp; DNS" Style="{StaticResource NavCategoryHeaderStyle}"/>
                                <RadioButton x:Name="NavDnsTools" Content="🌐  DNS Studio" Checked="Nav_Checked" Tag="DnsTools" Style="{StaticResource NavRadioStyle}"/>
                                <RadioButton x:Name="NavNetworkInfo" Content="📡  Network Info" Checked="Nav_Checked" Tag="NetworkInfo" Style="{StaticResource NavRadioStyle}"/>
                                <RadioButton x:Name="NavWifi" Content="📶  Wi-Fi Manager" Checked="Nav_Checked" Tag="Wifi" Style="{StaticResource NavRadioStyle}"/>

                                <TextBlock x:Name="LblNavCatSystem" Text="SYSTEM &amp; SECURITY" Style="{StaticResource NavCategoryHeaderStyle}"/>
                                <RadioButton x:Name="NavFixes" Content="🛡️  Fixes &amp; Hosts" Checked="Nav_Checked" Tag="Fixes" Style="{StaticResource NavRadioStyle}"/>
                                <RadioButton x:Name="NavMaintenance" Content="🔧  Maintenance" Checked="Nav_Checked" Tag="Maintenance" Style="{StaticResource NavRadioStyle}"/>

                                <TextBlock x:Name="LblNavCatApp" Text="PREFERENCES" Style="{StaticResource NavCategoryHeaderStyle}"/>
                                <RadioButton x:Name="NavSettings" Content="🎨  Settings" Checked="Nav_Checked" Tag="Settings" Style="{StaticResource NavRadioStyle}"/>
                                <RadioButton x:Name="NavHelp" Content="❓  Help" Checked="Nav_Checked" Tag="Help" Style="{StaticResource NavRadioStyle}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ==================== RIGHT MAIN CONTENT AREA ==================== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="ConsoleRow" Height="138"/>
                    </Grid.RowDefinitions>

                    <!-- ==================== TOP TELEMETRY STRIP (3 LIVE PINGS + ACTIVE DNS) ==================== -->
                    <UniformGrid x:Name="TelemetryStripGrid" Grid.Row="0" Columns="4" Margin="18,12,8,2">

                        <!-- 1. Global Ping: Click to cycle (1.1.1.1 / 8.8.8.8 / 9.9.9.9 / 4.2.2.4) -->
                        <Border x:Name="CardGlobalPing" Style="{StaticResource ClickableTelemetryPingCardStyle}" MouseLeftButtonUp="CardGlobalPing_Click" ToolTip="Click to switch Global ping server (1.1.1.1 / 8.8.8.8 / 9.9.9.9 / 4.2.2.4)">
                            <StackPanel>
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="PulseDot1" Grid.Column="0" Width="8" Height="8" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblPingCard1" Grid.Column="1" Text="GLOBAL · 1.1.1.1 ↻" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Border Grid.Column="1" Background="#2238BDF8" CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtBadgeGlobal" Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                </Grid>
                                <Grid Height="28" Margin="0,5,0,5" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtPingGlobal" Grid.Column="0" Text="-- ms" FontSize="19" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtJitterGlobal" Grid.Column="1" Text="±0ms · L:0%" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,0,0,3" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Height="4" Background="{DynamicResource InputSurfaceBrush}" Margin="0,0,0,6">
                                    <Border x:Name="BarPingGlobal" HorizontalAlignment="Left" Width="35" CornerRadius="2" Background="#38BDF8"/>
                                </Grid>
                                <TextBlock x:Name="TxtStatsGlobal" Text="Loss 0% · --/--/-- ms" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" FlowDirection="LeftToRight" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. Intranet Ping: Click to cycle (Arvan / SalatinGames / ParsVDS / Iran.ir) -->
                        <Border x:Name="CardIntranetPing" Style="{StaticResource ClickableTelemetryPingCardStyle}" MouseLeftButtonUp="CardIntranetPing_Click" ToolTip="Click to switch Intranet ping server (arvancloud.ir / salatingames.ir / parsvds.com / iran.ir)">
                            <StackPanel>
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="PulseDot2" Grid.Column="0" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblPingCard2" Grid.Column="1" Text="INTRANET · ARVAN ↻" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Border Grid.Column="1" Background="#2210B981" CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtBadgeIntranet" Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                                    </Border>
                                </Grid>
                                <Grid Height="28" Margin="0,5,0,5" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtPingIntranet" Grid.Column="0" Text="-- ms" FontSize="19" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" Foreground="#10B981" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtJitterIntranet" Grid.Column="1" Text="±0ms · L:0%" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,0,0,3" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Height="4" Background="{DynamicResource InputSurfaceBrush}" Margin="0,0,0,6">
                                    <Border x:Name="BarPingIntranet" HorizontalAlignment="Left" Width="35" CornerRadius="2" Background="#10B981"/>
                                </Grid>
                                <TextBlock x:Name="TxtStatsIntranet" Text="Loss 0% · --/--/-- ms" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" FlowDirection="LeftToRight" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. PC to Router / Wi-Fi Delay -->
                        <Border Style="{StaticResource TelemetryPingCardStyle}">
                            <StackPanel>
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="PulseDot3" Grid.Column="0" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtRouterCardTitle" Grid.Column="1" Text="PC ↔ ROUTER" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Border Grid.Column="1" Background="#22F59E0B" CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtBadgeRouter" Text="GATEWAY" FontSize="9" FontWeight="Bold" Foreground="#F59E0B"/>
                                    </Border>
                                </Grid>
                                <Grid Height="28" Margin="0,5,0,5" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtPingRouter" Grid.Column="0" Text="-- ms" FontSize="19" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtJitterRouter" Grid.Column="1" Text="±0ms · L:0%" FontSize="10.5" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6,0,0,3" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Height="4" Background="{DynamicResource InputSurfaceBrush}" Margin="0,0,0,6">
                                    <Border x:Name="BarPingRouter" HorizontalAlignment="Left" Width="35" CornerRadius="2" Background="#F59E0B"/>
                                </Grid>
                                <TextBlock x:Name="TxtStatsRouter" Text="Loss 0% · --/--/-- ms" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" FlowDirection="LeftToRight" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. Active System DNS & Traffic -->
                        <Border Style="{StaticResource TelemetryPingCardStyle}">
                            <StackPanel>
                                <Grid Height="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblActiveDnsCard" Grid.Column="0" Text="ACTIVE DNS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                    <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="6,1.5" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAdapterState" Text="Connected" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid Height="28" Margin="0,5,0,5" FlowDirection="LeftToRight">
                                    <TextBlock x:Name="TxtActiveDns" Text="Detecting..." FontSize="14" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Height="4" Background="{DynamicResource InputSurfaceBrush}" Margin="0,0,0,6">
                                    <Border HorizontalAlignment="Stretch" CornerRadius="2" Background="{DynamicResource AccentGradientBrush}"/>
                                </Grid>
                                <TextBlock x:Name="TxtDataUsage" Text="Rx 0.0 MB  ·  Tx 0.0 MB" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" FlowDirection="LeftToRight" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ==================== SCROLLABLE MODULE VIEWS ==================== -->
                    <ScrollViewer Grid.Row="1" Padding="18,10,18,12" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="WorkspaceAnimatedRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="WorkspaceScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="WorkspaceSlideTransform" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- ==================== VIEW: DASHBOARD ==================== -->
                            <StackPanel x:Name="ViewDashboard" Visibility="Visible">
                                <Border Style="{StaticResource SectionCardStyle}" Padding="16,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblDashStatusHeader" Grid.Column="0" Text="SYSTEM NETWORK STATUS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border x:Name="BdGameBoosterPill" Grid.Column="1" Background="#2210B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock x:Name="TxtGameBoosterPill" Text="GAME MODE ACTIVE" FontSize="9.5" FontWeight="Bold" Foreground="#10B981"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="TxtDashboardAdapterSummary"
                                                   Text="Scanning active Windows adaptor..."
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                                                   FlowDirection="LeftToRight"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Margin="0,6,0,12" TextWrapping="Wrap"/>

                                        <Border Height="1" Background="{DynamicResource BorderHairlineBrush}" Margin="0,0,0,12" Opacity="0.7"/>

                                        <!-- Strictly 4 Clean Primary Dashboard Actions -->
                                        <WrapPanel VerticalAlignment="Center">
                                            <Button x:Name="BtnGameBooster" Content="🎮 Game Booster" Click="BtnGameBooster_Click" Style="{StaticResource SuccessBtnStyle}" Padding="16,8" Margin="0,0,10,4"/>
                                            <Button x:Name="BtnDashFastestDns" Content="⚡ Fastest DNS" Click="BtnBenchmarkDns_Click" Style="{StaticResource PrimaryBtnStyle}" Padding="16,8" Margin="0,0,10,4"/>
                                            <Button x:Name="BtnDashResetDns" Content="↺ Reset DNS" Click="BtnResetDnsDhcp_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="16,8" Margin="0,0,10,4" ToolTip="Reset DNS to automatic DHCP and clear DNS cache"/>
                                            <Button x:Name="BtnDashResetAdapter" Content="↻ Reset Adaptor" Click="BtnFullAdapterReset_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="16,8" Margin="0,0,0,4" ToolTip="Full network adaptor reset and IP renew"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCardStyle}" Padding="16,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblDashQuickDnsTitle" Grid.Column="0" Text="QUICK DNS SWITCHER" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                            <TextBox x:Name="TxtSearchDns" Grid.Column="1" Width="220" Height="32" FlowDirection="LeftToRight" TextChanged="TxtSearchDns_TextChanged" ToolTip="Search DNS by name or IP..."/>
                                        </Grid>
                                        <StackPanel x:Name="DashboardDnsContainer"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ==================== VIEW: DNS STUDIO ==================== -->
                            <StackPanel x:Name="ViewDnsTools" Visibility="Collapsed">
                                <Border Style="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblDnsConfigTitle" Text="DNS Configurator" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
                                            <ComboBox x:Name="ComboDnsProviders" Width="300" Height="34" FlowDirection="LeftToRight" Margin="0,0,10,8"/>
                                            <Button x:Name="BtnApplySelectedDns" Content="Apply Selected DNS" Click="BtnApplySelectedDns_Click" Style="{StaticResource PrimaryBtnStyle}"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="LblCustomDnsTitle" Text="Custom IPv4 DNS" FontSize="12" FontWeight="Bold" Margin="0,2,0,6"/>
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LblPrimaryDns" Text="Primary:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            <TextBox x:Name="TxtCustomDns1" Width="150" Height="34" FontFamily="{StaticResource MonoFontFamily}" FlowDirection="LeftToRight" Text="1.1.1.1" Margin="0,0,14,8"/>
                                            <TextBlock x:Name="LblSecondaryDns" Text="Secondary:" VerticalAlignment="Center" Margin="0,0,8,8"/>
