                                        <WrapPanel x:Name="SurfaceSwatchesWrapPanel" Margin="0,0,0,10"/>

                                        <!-- Glass Transparency, Brightness & Contrast Calibration Sliders -->
                                        <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="LblVisualCalibrationTitle" Grid.Column="0" Text="Display Calibration (Transparency, Brightness &amp; Contrast)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                    <Button x:Name="BtnResetVisuals" Grid.Column="1" Content="↺ Reset Visuals" Click="BtnResetVisuals_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="10,4" FontSize="11" Margin="0"/>
                                                </Grid>

                                                <UniformGrid x:Name="VisualSlidersGrid" Columns="3">
                                                    <!-- Transparency Slider -->
                                                    <StackPanel Margin="0,0,12,0">
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="LblTransparencySlider" Grid.Column="0" Text="Transparency" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock x:Name="TxtTransparencyValue" Grid.Column="1" Text="100%" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        </Grid>
                                                        <Slider x:Name="SliderTransparency" Minimum="35" Maximum="100" Value="100" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="VisualSlider_ValueChanged" FlowDirection="LeftToRight"/>
                                                    </StackPanel>

                                                    <!-- Brightness Slider -->
                                                    <StackPanel Margin="6,0,6,0">
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="LblBrightnessSlider" Grid.Column="0" Text="Brightness" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock x:Name="TxtBrightnessValue" Grid.Column="1" Text="100%" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        </Grid>
                                                        <Slider x:Name="SliderBrightness" Minimum="75" Maximum="130" Value="100" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="VisualSlider_ValueChanged" FlowDirection="LeftToRight"/>
                                                    </StackPanel>

                                                    <!-- Contrast Slider -->
                                                    <StackPanel Margin="12,0,0,0">
                                                        <Grid Margin="0,0,0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="LblContrastSlider" Grid.Column="0" Text="Contrast" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock x:Name="TxtContrastValue" Grid.Column="1" Text="100%" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        </Grid>
                                                        <Slider x:Name="SliderContrast" Minimum="80" Maximum="135" Value="100" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="VisualSlider_ValueChanged" FlowDirection="LeftToRight"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                                            <WrapPanel VerticalAlignment="Center">
                                                <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to System Tray" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,3,18,3" Checked="ChkSettings_Changed" Unchecked="ChkSettings_Changed"/>
                                                <CheckBox x:Name="ChkStartWithWindows" Content="Start with Windows" IsChecked="False" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,3,18,3" Checked="ChkStartWithWindows_Changed" Unchecked="ChkStartWithWindows_Changed"/>
                                                <CheckBox x:Name="ChkEnableWindowsDoh" Content="🔒 Windows DoH (Encrypted DNS)" IsChecked="False" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" VerticalAlignment="Center" Margin="0,3,18,3" Checked="ChkEnableWindowsDoh_Changed" Unchecked="ChkEnableWindowsDoh_Changed" ToolTip="Automatically connect DoH-supported DNS servers via Windows 11 DNS-over-HTTPS"/>
                                                <CheckBox x:Name="ChkRememberSettings" Content="Remember Settings" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,3,18,3" Checked="ChkSettings_Changed" Unchecked="ChkSettings_Changed"/>
                                                <CheckBox x:Name="ChkEnableLogging" Content="Save Action Log" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,3,18,3" Checked="ChkSettings_Changed" Unchecked="ChkSettings_Changed"/>
                                                <CheckBox x:Name="ChkDiagnosticLogs" Content="🐞 Diagnostic Bug Logs" IsChecked="False" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,3,0,3" Checked="ChkSettings_Changed" Unchecked="ChkSettings_Changed" ToolTip="Collect additional technical diagnostics (diagnostics.log) to include in bug reports"/>
                                            </WrapPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Updates, Backup & Compact Action Log -->
                                <Border Style="{StaticResource SectionCardStyle}" Padding="16,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblAppUpdateTitle" Grid.Column="0" Text="Updates &amp; Settings Backup" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                <Button x:Name="BtnCheckUpdate" Content="↻ Check for Updates" Click="BtnCheckUpdate_Click" Style="{StaticResource PrimaryBtnStyle}" Padding="12,6" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnSendBugReport" Content="🐞 Send Bug Report" Click="BtnSendBugReport_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="11,6" Margin="0,0,8,0" ToolTip="Export sanitized diagnostic logs ZIP and open GitHub issue tracker"/>
                                                <Button x:Name="BtnExportSettings" Content="📤 Export" Click="BtnExportSettings_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="11,6" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnImportSettings" Content="📥 Import" Click="BtnImportSettings_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="11,6" Margin="0"/>
                                            </WrapPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource BorderHairlineBrush}" Margin="0,4,0,10"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LblActionLogTitle" Grid.Column="0" Text="Action Log" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button x:Name="BtnViewLog" Content="Refresh" Click="BtnViewLog_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="10,4" Margin="0,0,6,0"/>
                                                <Button x:Name="BtnClearLog" Content="Clear" Click="BtnClearLog_Click" Style="{StaticResource DangerBtnStyle}" Padding="10,4" Margin="0"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBox x:Name="TxtActionLogContent" IsReadOnly="True" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" FlowDirection="LeftToRight" VerticalContentAlignment="Top" Height="165" VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ==================== VIEW: HELP (FULL BILINGUAL EN + FA RTL GUIDE) ==================== -->
                            <StackPanel x:Name="ViewHelp" Visibility="Collapsed">
                                <Border Style="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <TextBlock x:Name="LblHelpTitle" Text="AionToolPro — Complete Feature &amp; Button Guide" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="LblHelpSubtitle" Text="Visual reference explaining every indicator, button, and tool inside AionToolPro." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,14"/>

                                        <UniformGrid x:Name="HelpCardsGrid" Columns="2">
                                            <!-- Card 1 -->
                                            <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,10">
                                                <StackPanel>
                                                    <TextBlock x:Name="LblHelpCard1Title" Text="⚡ Status Light &amp; Network Adaptor" FontWeight="Bold" FontSize="13.5" Foreground="#38BDF8" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtHelpCard1Body" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" LineHeight="20"
                                                               Text="• Status LED: Green = healthy internet, Amber = high packet loss (&gt;=10%), Red = offline.&#x0a;• Network Adaptor Dots: Scans real physical adapters. Green = Connected, Orange = Disconnected, Red = Disabled.&#x0a;• Live Sync &amp; Speedometer: Independent 1-second NIC stats (⬇/⬆ speed, Rx/Tx, NIC drops) never freeze during ping timeouts."/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 2 -->
                                            <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,10">
                                                <StackPanel>
                                                    <TextBlock x:Name="LblHelpCard2Title" Text="📊 Interactive Live Ping Monitors" FontWeight="Bold" FontSize="13.5" Foreground="#10B981" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtHelpCard2Body" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" LineHeight="20"
                                                               Text="• Click Global Card to Switch Server: Cycles between 1.1.1.1 (Cloudflare), 8.8.8.8 (Google), 9.9.9.9 (Quad9), and 4.2.2.4.&#x0a;• Click Intranet Card to Switch Server: Cycles between arvancloud.ir, salatingames.ir, parsvds.com, and iran.ir.&#x0a;• System-Grade Accuracy: Standard 32-byte TTL=128 ICMP, RFC 3550 jitter, honest 40-packet loss, and automatic TCP ONLY fallback if ICMP is blocked."/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 3 -->
                                            <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,10">
                                                <StackPanel>
                                                    <TextBlock x:Name="LblHelpCard3Title" Text="🌐 DNS Studio, Profiles &amp; DoH" FontWeight="Bold" FontSize="13.5" Foreground="#F59E0B" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtHelpCard3Body" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" LineHeight="20"
                                                               Text="• Quick DNS &amp; Search: Click any DNS card on the Dashboard or filter by name/IP. Automatically resets IPv6 DNS to prevent leaks on IPv4-only anti-sanction DNS.&#x0a;• Custom Profiles &amp; UDP/53 Benchmark: Save your own DNS profiles and benchmark all resolvers using real UDP port 53 queries.&#x0a;• Windows 11 DoH: Enables encrypted DNS-over-HTTPS (udpfallback=yes) with safe backup/restore."/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 4 -->
                                            <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,10">
                                                <StackPanel>
                                                    <TextBlock x:Name="LblHelpCard4Title" Text="📡 Diagnostics, STUN NAT &amp; App Monitor" FontWeight="Bold" FontSize="13.5" Foreground="#A855F7" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtHelpCard4Body" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" LineHeight="20"
                                                               Text="• STUN NAT &amp; Speed Test: Dual-server RFC 5389 UDP STUN detects Open/Cone/Symmetric NAT &amp; CGNAT; 2-stream Cloudflare speed test &amp; Game Server Pings.&#x0a;• Active Connections (IPv4/IPv6): Live socket monitor with search, protected process guard, and SHA-256 hashed Windows Firewall block/unblock.&#x0a;• Ping Monitor, Traceroute &amp; Port Check: Live cancellable diagnostics."/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 5 -->
                                            <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="LblHelpCard5Title" Text="📶 Wi-Fi Manager &amp; Atomic Hosts" FontWeight="Bold" FontSize="13.5" Foreground="#FB923C" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtHelpCard5Body" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" LineHeight="20"
                                                               Text="• Wi-Fi Profiles: Language-independent extraction with passwords masked by default — reveal, copy, or forget any saved network safely.&#x0a;• Hosts Blocklists: Atomic UTF-8 (no BOM) writes with automatic timestamped backups, multi-host line parsing, and ad/malware/TeamSpeak filters."/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 6 -->
                                            <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="4,0,4,0">
                                                <StackPanel>
                                                    <TextBlock x:Name="LblHelpCard6Title" Text="🛡️ Game Booster, Maintenance &amp; Updates" FontWeight="Bold" FontSize="13.5" Foreground="#F43F5E" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="TxtHelpCard6Body" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" LineHeight="20"
                                                               Text="• Safe Game Booster: Pauses only currently running non-essential services and restores exact original state with Restore Normal.&#x0a;• Maintenance &amp; Repair: 24h-guarded Temp cleaner (protects %TEMP%\.net), DISM+SFC, safe Windows Update reset, Proxy &amp; Firewall backup/reset.&#x0a;• System Tray &amp; Auto-Updater: Quick DNS tray menu, elevated Start-with-Windows, and SHA-256 verified silent GitHub updates."/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>

                    <!-- ==================== BOTTOM CONSOLE STREAM ==================== -->
                    <Border x:Name="ConsoleBorder" Grid.Row="2" Background="{DynamicResource SidebarSurfaceBrush}" BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="0,1,0,0" Padding="18,8">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblConsoleHeader" Grid.Column="0" Text="▶ LIVE COMMAND STREAM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnCancelCommand" Content="⏹ Stop" Click="BtnCancelCommand_Click" Style="{StaticResource DangerBtnStyle}" Padding="10,2" Margin="0,0,6,0" ToolTip="Cancel running command"/>
                                    <Button x:Name="BtnClearConsole" Content="Clear" Click="BtnClearConsole_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="10,2" Margin="0"/>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="ConsoleOutputBox" IsReadOnly="True" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" FlowDirection="LeftToRight" VerticalContentAlignment="Top" Background="{DynamicResource InputSurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderHairlineBrush}" Padding="8,5" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== GRAPHICAL SOFTWARE UPDATE CENTER MODAL ==================== -->
            <Border x:Name="UpdateModalOverlay"
                    Grid.Row="0" Grid.RowSpan="2"
                    Background="#B8060911"
                    Visibility="Collapsed"
                    Panel.ZIndex="99">
                <Border x:Name="UpdateModalCard"
                        Width="500"
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PopupSurfaceBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5"
                        CornerRadius="16"
                        Padding="22,20"
                        RenderTransformOrigin="0.5,0.5"
                        Effect="{StaticResource CardShadowEffect}">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="UpdateModalScaleTransform" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>

                    <StackPanel>
                        <!-- Modal Header -->
                        <DockPanel Margin="0,0,0,14">
                            <Border x:Name="BdUpdateIconCircle"
                                    Width="44" Height="44"
                                    CornerRadius="22"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1.5"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUpdateIcon" Text="↻" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Button x:Name="BtnUpdateModalCloseTop"
                                    DockPanel.Dock="Right"
                                    Content="✕"
                                    Click="BtnUpdateClose_Click"
                                    Style="{StaticResource WindowChromeBtnStyle}"
                                    Width="32" Height="32"
                                    VerticalAlignment="Top"
                                    ToolTip="Close"/>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtUpdateTitle" Text="Software Update" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="TxtUpdateSubtitle" Text="Checking GitHub Releases..." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Version Comparison & Security Strip -->
                        <Border x:Name="BdUpdateVersionStrip"
                                Background="{DynamicResource InputSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,9"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtUpdateVersionFlow"
                                           Grid.Column="0"
                                           Text="v0.9.2  →  v0.9.3"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           FlowDirection="LeftToRight"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="BdUpdateVerifyBadge"
                                        Grid.Column="1"
                                        Background="#2210B981"
                                        BorderBrush="#10B981"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtUpdateVerifyText" Text="🔒 HTTPS + SHA-256" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Graphical Progress Panel (Checking / Downloading / Verifying) -->
                        <Border x:Name="PanelUpdateProgress"
                                Background="{DynamicResource InputSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12"
                                Margin="0,0,0,12"
                                Visibility="Visible">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtUpdateStage" Grid.Column="0" Text="Connecting to GitHub..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Margin="0,0,10,2"/>
                                    <TextBlock x:Name="TxtUpdatePercent" Grid.Column="1" Text="0%" FontFamily="{StaticResource MonoFontFamily}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" FlowDirection="LeftToRight"/>
                                </Grid>

                                <ProgressBar x:Name="BarUpdateProgress"
                                             Style="{StaticResource ModernProgressBarStyle}"
                                             Minimum="0" Maximum="100" Value="0"
                                             IsIndeterminate="True"
                                             FlowDirection="LeftToRight"/>

                                <TextBlock x:Name="TxtUpdateTransferStats"
                                           Text="Preparing secure TLS 1.3 connection..."
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="11"
                                           FlowDirection="LeftToRight"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Graphical Status Banner (Up-To-Date / Cancelled / Error / Installing) -->
                        <Border x:Name="BdUpdateStatusBanner"
                                Background="#2210B981"
                                BorderBrush="#10B981"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="13,10"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TxtUpdateStatusBanner"
                                       Text=""
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="19"/>
                        </Border>

                        <!-- Scrollable Release Notes / Error Details Box -->
                        <Border x:Name="BdUpdateNotesBox"
                                Background="{DynamicResource InputSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,8"
                                Margin="0,0,0,14"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="LblUpdateNotesHeader" Text="Release Notes" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtUpdateNotes"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="{StaticResource UiFontFamily}"
                                         FontSize="11.5"
                                         FlowDirection="LeftToRight"
                                         VerticalContentAlignment="Top"
                                         Height="120"
                                         Padding="0"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>

                        <!-- Modal Footer Buttons -->
                        <WrapPanel HorizontalAlignment="Right" Margin="0,2,0,0">
                            <Button x:Name="BtnUpdateStartDownload" Content="⬇ Download &amp; Install" Click="BtnUpdateStartDownload_Click" Style="{StaticResource PrimaryBtnStyle}" Padding="16,8" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <Button x:Name="BtnUpdateRetry" Content="↻ Retry" Click="BtnUpdateRetry_Click" Style="{StaticResource PrimaryBtnStyle}" Padding="16,8" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <Button x:Name="BtnUpdateCancel" Content="⏹ Cancel" Click="BtnUpdateCancel_Click" Style="{StaticResource DangerBtnStyle}" Padding="16,8" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <Button x:Name="BtnUpdateClose" Content="Close" Click="BtnUpdateClose_Click" Style="{StaticResource SecondaryBtnStyle}" Padding="16,8" Margin="0" Visibility="Collapsed"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
