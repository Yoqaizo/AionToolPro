<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>AionToolp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AionToolPro</AssemblyName>
    <RootNamespace>AionToolPro.Desktop</RootNamespace>
    <Version>0.8.6</Version>
    <AssemblyVersion>0.8.6.0</AssemblyVersion>
    <FileVersion>0.8.6.0</FileVersion>
    <Authors>Yoqaizo</Authors>
    <Product>AionToolPro</Product>
    <Description>AionToolPro - Windows DNS &amp; Network Suite</Description>
    <TieredCompilation>true</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AionToolp.ico" />
    <Resource Include="AionToolp.png" />
  </ItemGroup>

</Project>
