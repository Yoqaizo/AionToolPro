<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>AionToolp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AionToolPro</AssemblyName>
    <RootNamespace>AionToolPro.Desktop</RootNamespace>
    <Version>0.5.0</Version>
    <Authors>TheYoqaizo</Authors>
    <Product>AionToolPro</Product>
    <Description>AionToolPro - Windows DNS &amp; Network Suite</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AionToolp.ico" />
    <Resource Include="AionToolp.png" />
  </ItemGroup>

</Project>
